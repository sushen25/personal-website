# AWS Configuration (for local development)
AWS_REGION=ap-southeast-2
AWS_PROFILE=default

# Stage
STAGE=dev

# DynamoDB Table Names (auto-generated based on stage)
CHAT_CONVERSATIONS_TABLE=dev-portfolio-chat-conversations
BLOG_POSTS_TABLE=dev-portfolio-blog-posts
ANALYTICS_TABLE=dev-portfolio-analytics

# Agent Service Configuration
# For local development, point to the local agentcore runtime
AGENT_SERVICE_URL=http://localhost:8080
# For deployed environment, set this to the deployed agent service URL

# API Keys (stored in AWS Secrets Manager in production)
# These are only needed for local development
# OPENAI_API_KEY=your-openai-key
# GEMINI_API_KEY=your-gemini-key
# CLAUDE_API_KEY=your-claude-key
